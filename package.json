{
  "name": "floodroute-hcmc",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "node scripts/dev.mjs --frontend-only",
    "dev:backend": "node scripts/dev.mjs --backend-only",
    "build:frontend": "npm --prefix frontend run build",
    "test:frontend": "npm --prefix frontend run test",
    "test:backend": "python -m pytest backend/tests",
    "test:data": "python scripts/data/validate_dataset.py",
    "test": "npm run test:data && npm run test:backend && npm run test:frontend"
  }
}
