{
  "name": "floodroute-hcmc",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "node scripts/dev.mjs --frontend-only",
    "dev:backend": "node scripts/dev.mjs --backend-only",
    "build:frontend": "npm --prefix frontend run build",
    "test:frontend": "npm --prefix frontend run test",
    "test:backend": "node scripts/python.mjs -m pytest backend/tests",
    "test:data": "node scripts/python.mjs scripts/data/validate_dataset.py",
    "benchmark:capacity": "node scripts/python.mjs scripts/benchmark_capacity.py",
    "benchmark:search": "node scripts/python.mjs scripts/benchmark_search.py --output experiments/results/search_benchmark_v1.json",
    "benchmark:lower-bound": "node scripts/python.mjs scripts/benchmark_lower_bound.py --output-json experiments/results/astar_ucs_lower_bound_v1.json --output-markdown experiments/results/astar_ucs_lower_bound_v1.md",
    "benchmark:cost-profiles": "node scripts/python.mjs scripts/benchmark_cost_profiles.py --output-json experiments/results/cost_profiles_v1.json --output-markdown experiments/results/cost_profiles_v1.md",
    "test": "npm run test:data && npm run test:backend && npm run test:frontend"
  }
}
