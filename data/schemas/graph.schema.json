{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://floodroute.local/schemas/graph.schema.json",
  "title": "FloodRoute processed graph",
  "type": "object",
  "required": ["dataset_version", "data_status", "nodes", "edges"],
  "properties": {
    "dataset_version": {"type": "string", "minLength": 1},
    "data_status": {
      "enum": ["SOURCE_BACKED", "DERIVED", "SIMULATED", "MIXED"]
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["node_id", "latitude", "longitude", "source_id"],
        "properties": {
          "node_id": {"type": "string", "minLength": 1},
          "latitude": {"type": "number", "minimum": -90, "maximum": 90},
          "longitude": {"type": "number", "minimum": -180, "maximum": 180},
          "source_id": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["edge_id", "from_node_id", "to_node_id", "distance_m", "free_flow_time_min"],
        "properties": {
          "edge_id": {"type": "string", "minLength": 1},
          "from_node_id": {"type": "string", "minLength": 1},
          "to_node_id": {"type": "string", "minLength": 1},
          "distance_m": {"type": "number", "exclusiveMinimum": 0},
          "free_flow_time_min": {"type": "number", "exclusiveMinimum": 0}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}

